[Unit]
Description=LB Node - Maglev-inspired L4 Load Balancer
Documentation=https://github.com/thewillyhuman/lb
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Run as a dedicated unprivileged user. Capabilities below grant exactly
# the privileges the binary needs (raw socket access for AF_XDP / AF_PACKET,
# binding low ports for BGP), nothing more.
#
# Create the user once at install time:
#     useradd --system --no-create-home --shell /usr/sbin/nologin lb-node
User=lb-node
Group=lb-node

# Main binary
ExecStart=/usr/local/bin/lb-node --config /etc/lb/config.toml

# Config validation before start
ExecStartPre=/usr/local/bin/lb-node --config /etc/lb/config.toml --check-config

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60
StartLimitBurst=5

# Resource limits
LimitNOFILE=1048576
LimitMEMLOCK=infinity

# Capabilities granted (still runs as the unprivileged `lb-node` user):
#   CAP_NET_ADMIN       — needed to attach XDP programs and load BPF for AF_XDP.
#   CAP_NET_RAW         — raw / packet sockets (AF_XDP, AF_PACKET fallback).
#   CAP_NET_BIND_SERVICE — bind TCP/179 for the BGP speaker without needing root.
#   CAP_SYS_RESOURCE    — raise LimitMEMLOCK / RLIMIT_MEMLOCK for the UMEM ring buffers.
#   CAP_BPF             — load and verify BPF programs on Linux >= 5.8 (split out of
#                         CAP_SYS_ADMIN). Drop this on older kernels.
#   CAP_PERFMON         — perf_event_open for BPF maps with array-of-perf-events
#                         (some XDP loaders use it). Drop on older kernels.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_RESOURCE CAP_BPF CAP_PERFMON
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_RESOURCE CAP_BPF CAP_PERFMON

# Hugepages (needed for AF_XDP UMEM and, historically, DPDK).
# Ensure hugepages are configured: echo 1024 > /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages

# CPU affinity — pin to specific cores to avoid interference.
# Adjust to match your hardware. Typically:
#   Core 0: steering thread
#   Cores 1-N: rewriter threads
#   Core N+1: muxer thread + controller (tokio)
# CPUAffinity=0-8

# Security hardening. Tightened in lock-step with dropping User=root: with
# capabilities listed above, NoNewPrivileges=yes is finally safe — exec'd
# children (e.g. the ExecStartPre validator) inherit only what we granted.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/lb /etc/lb
PrivateTmp=yes
PrivateDevices=no            # AF_XDP needs /dev/null + bpf fs; PrivateDevices=yes blocks that.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Allow network-related syscalls only. `@network-io` covers everything the
# data plane needs; `@system-service` is the systemd-recommended baseline
# for daemons.
SystemCallFilter=@system-service @network-io
SystemCallFilter=~@privileged @resources @reboot @swap @debug

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lb-node

# Environment
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1

[Install]
WantedBy=multi-user.target
